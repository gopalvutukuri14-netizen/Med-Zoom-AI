# ==========================================
# MedZoom AI - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
*/node_modules/

# Python Virtual Environments & Caches
venv/
*/venv/
ENV/
env/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Build artifacts
dist/
*/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
