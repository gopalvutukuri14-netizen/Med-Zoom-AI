# ==========================================
# MedZoom AI - Backend Configuration (.env)
# ==========================================

# Server Port (Cloud platforms set process.env.PORT automatically)
PORT=8000

# MongoDB Connection String:
# Local development:
#   mongodb://localhost:27017/medzoom
# Global Cloud (MongoDB Atlas):
#   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medzoom?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medzoom

# Secret key used to sign and verify user authentication tokens
JWT_SECRET=mysecretkey123

# Google Gemini API Key for automated radiology report generation
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP credentials for sending 6-digit signup OTPs
# NOTE: Must be a 16-character Google App Password (not your Gmail login password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# AI Analyst Prediction Service URL
# Local: http://localhost:5001
# Production: e.g. https://your-ai-service.onrender.com
AI_PREDICT_TARGET=http://localhost:5001
